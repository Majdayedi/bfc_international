[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Majdayedi/bfc-backend.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	vscode-merge-base = origin/main
	merge = refs/heads/main
[branch "version1.0"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/version1.0
[branch "version2.1"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/version2.1
