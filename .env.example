# Copy to .env and fill in before docker compose up.

# Required
MYSQL_ROOT_PASSWORD=changeMe-StrongPassword
JWT_SECRET=generate-a-long-random-string-min-256-bits

# Public URLs your visitors' browsers use (NOT internal container names).
# These are baked into the frontend bundle and the backend CORS check.
PUBLIC_SITE_URL=https://your-domain.com
PUBLIC_API_URL=https://your-domain.com/api

FRONTEND_PORT=80
BACKEND_PORT=8085

# Optional: leave empty to use the self-hosted LibreTranslate provider.
# Fill in only if/when you create the Azure Translator F0 resource — it then
# takes priority over LibreTranslate automatically.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
